# Required: SchwabGateway connection.
SCHWAB_GATEWAY_URL=
SCHWAB_GATEWAY_API_KEY=
SCHWAB_GATEWAY_TIMEOUT_SECONDS=
SCHWAB_GATEWAY_MAX_ATTEMPTS=
SCHWAB_GATEWAY_RETRY_BACKOFF_SECONDS=

# Optional: news providers. A provider is skipped when its value is unset.
SEC_USER_AGENT=
ALPHA_VANTAGE_API_KEY=

# Optional: needed only to post reports (runs without --dry-run).
EQUITY_SCANNER_DISCORD_WEBHOOK_URL=
