# One-day bounded parity proof. The ButterflyGuy reference runs first at 09:00 ET;
# the gateway-backed candidate starts at 09:10 ET and fails closed at 09:20 ET.
# The 09:45 ET comparison is offline and performs no gateway calls.
10 13 * * * /usr/bin/env EQUITY_SCANNER_PARITY_DATE=2026-09-10 /opt/equity-scanner/tools/run_parity_scan.sh >> /opt/equity-scanner/reports/parity-coordinator.log 2>&1
45 13 * * * /usr/bin/env EQUITY_SCANNER_PARITY_DATE=2026-09-10 /opt/equity-scanner/tools/compare_parity_scan.sh >> /opt/equity-scanner/reports/parity-coordinator.log 2>&1
